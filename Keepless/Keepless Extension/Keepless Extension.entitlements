<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Data protection keychain for the Touch ID secret (SafariWebExtensionHandler.swift) -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.keepless.Keepless</string>
	</array>
</dict>
</plist>
